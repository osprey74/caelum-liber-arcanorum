{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liber Arcanorum",
  "version": "1.0.0",
  "identifier": "com.osprey74.liberarcanorum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liber Arcanorum",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "osprey74",
    "copyright": "© 2026 osprey74",
    "category": "Lifestyle",
    "shortDescription": "Tarot reading app of the Caelum series",
    "longDescription": "Liber Arcanorum is a tarot reading app with original card art, four spreads, card meanings and optional AI interpretations.",
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
